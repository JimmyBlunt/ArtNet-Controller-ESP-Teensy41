{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schrank-led.local/schemas/mapping.schema.json",
  "title": "Schrank LED Mapping",
  "type": "object",
  "required": ["id", "version", "pixelCount", "dimensions", "points"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "const": 1 },
    "pixelCount": { "type": "integer", "minimum": 1 },
    "dimensions": { "type": "integer", "minimum": 1, "maximum": 3 },
    "fit": { "type": "string", "enum": ["none", "fill", "contain"] },
    "source": { "type": "string" },
    "points": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "items": { "type": "number" }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "startPixel", "pixelCount"],
        "properties": {
          "id": { "type": "integer" },
          "startPixel": { "type": "integer", "minimum": 0 },
          "pixelCount": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
